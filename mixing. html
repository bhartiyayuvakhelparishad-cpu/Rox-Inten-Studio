<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Rox INTEN STUDIO - Multi-Track Video Mixer</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Arial, sans-serif; touch-action: manipulation; }
        body { background: #0c0c14; color: #fff; min-height: 100vh; display: flex; flex-direction: column; overflow-x: hidden; }

        .top-navbar { background: #161625; padding: 10px 12px; border-bottom: 2px solid #28283d; position: sticky; top: 0; z-index: 100; }
        .nav-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
        .logo-area h1 { color: #00e5ff; font-size: 18px; display: inline-block; }
        .logo-area span { color: #ff007f; font-size: 9px; font-weight: bold; }

        .nav-links { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 4px; -webkit-overflow-scrolling: touch; }
        .nav-links::-webkit-scrollbar { display: none; }
        .nav-links a { color: #ccc; text-decoration: none; font-size: 11px; padding: 5px 10px; background: #222235; border-radius: 5px; white-space: nowrap; border: 1px solid #383852; }
        .nav-links a.active { background: #00e5ff; color: #000; font-weight: bold; }

        .mixing-container { display: flex; flex-direction: column; padding: 10px; gap: 12px; width: 100%; max-width: 600px; margin: 0 auto; }

        .preview-box { position: relative; width: 100%; aspect-ratio: 16/9; background: #000; border: 2px solid #00e5ff; border-radius: 8px; overflow: hidden; }
        canvas { width: 100%; height: 100%; object-fit: contain; }
        .time-display { position: absolute; bottom: 8px; right: 10px; background: rgba(0,0,0,0.85); color: #00e5ff; font-size: 11px; padding: 3px 8px; border-radius: 4px; border: 1px solid #00e5ff; }

        .controls-bar { display: flex; gap: 8px; width: 100%; }
        .btn { flex: 1; padding: 12px; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 13px; text-align: center; }
        .btn-play { background: #00e5ff; color: #000; }
        .btn-mix { background: linear-gradient(90deg, #ff007f, #7f00ff); color: #fff; }

        .timeline-tracks { width: 100%; background: #12121c; border-radius: 8px; padding: 10px; border: 1px solid #2e2e48; display: flex; flex-direction: column; gap: 10px; }
        .track { background: #1a1a2b; padding: 8px; border-radius: 6px; border: 1px solid #28283d; }
        .track-title { font-size: 11px; color: #00e5ff; font-weight: bold; margin-bottom: 6px; display: flex; justify-content: space-between; align-items: center; }
        .track-title span { color: #ff007f; font-size: 10px; }
        
        .track-lane { position: relative; height: 42px; background: #09090f; border-radius: 5px; overflow: hidden; border: 1px dashed #3e3e5e; }
        .clip-block { position: absolute; top: 3px; height: 34px; background: #00e5ff; color: #000; font-size: 10px; font-weight: bold; display: flex; align-items: center; justify-content: center; border-radius: 4px; touch-action: none; user-select: none; border: 1px solid #fff; cursor: grab; }
        .clip-block.audio { background: #ff007f; color: #fff; }

        .sidebar-panel { background: #12121c; padding: 12px; border-radius: 8px; border: 1px solid #2e2e48; display: flex; flex-direction: column; gap: 10px; }
        .input-group { background: #1a1a2b; padding: 8px; border-radius: 6px; border: 1px solid #28283d; }
        .input-group label { font-size: 11px; color: #00e5ff; font-weight: bold; display: block; margin-bottom: 4px; }
        input[type="file"] { width: 100%; font-size: 11px; background: #222235; color: #fff; padding: 6px; border-radius: 4px; border: 1px solid #383852; }

        .vol-control { display: flex; align-items: center; gap: 8px; margin-top: 6px; }
        .vol-control label { font-size: 10px; color: #ff007f; min-width: 70px; }

        .trim-controls { display: flex; gap: 8px; margin-top: 6px; }
        .trim-controls div { flex: 1; }
        .trim-controls label { font-size: 9px; color: #aaa; display: block; }
        input[type="range"] { width: 100%; accent-color: #00e5ff; }
    </style>
</head>
<body>

    <div class="top-navbar">
        <div class="nav-header">
            <div class="logo-area">
                <h1>Rox</h1> <span>INTEN STUDIO</span>
            </div>
            <div><span style="font-size: 10px; color: #00e5ff;">⏱️ Multi-Track Mixer</span></div>
        </div>
        <div class="nav-links">
            <a href="index.html">Home</a>
            <a href="upload.html">Upload</a>
            <a href="ai-tools.html">AI Magic</a>
            <a href="projects.html">Projects</a>
            <a href="mixing.html" class="active">Mixing</a>
            <a href="cutter.html">Cutter</a>
            <a href="support.html">Support</a>
        </div>
    </div>

    <div class="mixing-container">
        
        <div class="preview-box">
            <canvas id="mixCanvas"></canvas>
            <div class="time-display" id="timeDisplay">0.0s / 60.0s</div>
        </div>

        <div class="controls-bar">
            <button class="btn btn-play" id="playBtn" onclick="togglePlay()">▶ Play / Pause</button>
            <button class="btn btn-mix" id="exportBtn" onclick="exportMix()">⚡ Merge & Download</button>
        </div>

        <div class="timeline-tracks">
            <h4 style="font-size: 11px; color: #aaa; text-align: center;">👈 Ungli Se Block Slide Karke Start Position Set Karein 👉</h4>
            
            <div class="track">
                <div class="track-title">📹 Video 1 Track <span id="v1TimeLabel">Start: 0.0s</span></div>
                <div class="track-lane" id="laneV1">
                    <div class="clip-block" id="clipV1" style="left: 0px; width: 45%;">Video 1</div>
                </div>
            </div>

            <div class="track">
                <div class="track-title">📹 Video 2 Track <span id="v2TimeLabel">Start: 15.0s</span></div>
                <div class="track-lane" id="laneV2">
                    <div class="clip-block" id="clipV2" style="left: 150px; width: 45%;">Video 2</div>
                </div>
            </div>

            <div class="track">
                <div class="track-title">🎵 Audio Track <span id="a1TimeLabel">Start: 0.0s</span></div>
                <div class="track-lane" id="laneA1">
                    <div class="clip-block audio" id="clipA1" style="left: 0px; width: 50%;">Audio 1</div>
                </div>
            </div>
        </div>

        <div class="sidebar-panel">
            <h3 style="color:#00e5ff; font-size:12px;">🔊 Audio Mixer & Volume Control</h3>

            <div class="input-group">
                <label>📹 Video 1 Controls</label>
                <input type="file" id="v1File" accept="video/*">
                <div class="vol-control">
                    <label>🔊 Volume:</label>
                    <input type="range" id="v1Vol" min="0" max="1" step="0.1" value="1" oninput="updateVolumes()">
                </div>
                <div class="trim-controls">
                    <div><label>Cut Start (s)</label><input type="range" id="v1Start" value="0" min="0" max="60"></div>
                    <div><label>Cut End (s)</label><input type="range" id="v1End" value="60" min="0" max="60"></div>
                </div>
            </div>

            <div class="input-group">
                <label>📹 Video 2 Controls</label>
                <input type="file" id="v2File" accept="video/*">
                <div class="vol-control">
                    <label>🔊 Volume:</label>
                    <input type="range" id="v2Vol" min="0" max="1" step="0.1" value="1" oninput="updateVolumes()">
                </div>
                <div class="trim-controls">
                    <div><label>Cut Start (s)</label><input type="range" id="v2Start" value="0" min="0" max="60"></div>
                    <div><label>Cut End (s)</label><input type="range" id="v2End" value="60" min="0" max="60"></div>
                </div>
            </div>

            <div class="input-group">
                <label>🎵 Audio 1 Background Track</label>
                <input type="file" id="a1File" accept="audio/*">
                <div class="vol-control">
                    <label>🎵 Volume:</label>
                    <input type="range" id="a1Vol" min="0" max="1" step="0.1" value="1" oninput="updateVolumes()">
                </div>
            </div>
        </div>

    </div>

    <video id="vid1" style="display:none;" playsinline></video>
    <video id="vid2" style="display:none;" playsinline></video>
    <audio id="aud1" style="display:none;"></audio>

    <script>
        const canvas = document.getElementById('mixCanvas');
        const ctx = canvas.getContext('2d');
        canvas.width = 640;
        canvas.height = 360;

        const vid1 = document.getElementById('vid1');
        const vid2 = document.getElementById('vid2');
        const aud1 = document.getElementById('aud1');

        let isPlaying = false;
        let isRecording = false;
        let mediaRecorder;
        let recordedChunks = [];
        let currentTime = 0;
        const totalTimelineDuration = 60;

        let v1StartSec = 0, v2StartSec = 15, a1StartSec = 0;

        document.getElementById('v1File').addEventListener('change', (e) => loadMedia(e, vid1, 'clipV1', 'v1End'));
        document.getElementById('v2File').addEventListener('change', (e) => loadMedia(e, vid2, 'clipV2', 'v2End'));
        document.getElementById('a1File').addEventListener('change', (e) => loadMedia(e, aud1, 'clipA1', null));

        function loadMedia(event, element, clipId, maxRangeId) {
            const file = event.target.files[0];
            if (file) {
                element.src = URL.createObjectURL(file);
                document.getElementById(clipId).innerText = file.name.substring(0, 10) + '..';
                element.onloadedmetadata = () => {
                    if(maxRangeId) {
                        document.getElementById(maxRangeId).max = Math.floor(element.duration);
                        document.getElementById(maxRangeId).value = Math.floor(element.duration);
                    }
                };
            }
        }

        function updateVolumes() {
            vid1.volume = parseFloat(document.getElementById('v1Vol').value);
            vid2.volume = parseFloat(document.getElementById('v2Vol').value);
            aud1.volume = parseFloat(document.getElementById('a1Vol').value);
        }

        setupDraggable('clipV1', 'laneV1', (sec) => { v1StartSec = sec; document.getElementById('v1TimeLabel').innerText = `Start: ${sec.toFixed(1)}s`; });
        setupDraggable('clipV2', 'laneV2', (sec) => { v2StartSec = sec; document.getElementById('v2TimeLabel').innerText = `Start: ${sec.toFixed(1)}s`; });
        setupDraggable('clipA1', 'laneA1', (sec) => { a1StartSec = sec; document.getElementById('a1TimeLabel').innerText = `Start: ${sec.toFixed(1)}s`; });

        function setupDraggable(clipId, laneId, onMoveCallback) {
            const clip = document.getElementById(clipId);
            const lane = document.getElementById(laneId);

            const moveHandler = (clientX) => {
                const rect = lane.getBoundingClientRect();
                let left = clientX - rect.left - (clip.clientWidth / 2);
                let maxLeft = lane.clientWidth - clip.clientWidth;

                if (left < 0) left = 0;
                if (left > maxLeft) left = maxLeft;

                clip.style.left = left + 'px';
                let startSec = (left / lane.clientWidth) * totalTimelineDuration;
                onMoveCallback(startSec);
            };

            clip.addEventListener('touchmove', (e) => {
                e.preventDefault();
                moveHandler(e.touches[0].clientX);
            }, { passive: false });

            let isDragging = false;
            clip.addEventListener('mousedown', () => isDragging = true);
            window.addEventListener('mousemove', (e) => { if (isDragging) moveHandler(e.clientX); });
            window.addEventListener('mouseup', () => isDragging = false);
        }

        function togglePlay() {
            isPlaying = !isPlaying;
            document.getElementById('playBtn').innerText = isPlaying ? "⏸ Pause" : "▶ Play";
            if (isPlaying) renderLoop();
        }

        function renderLoop() {
            if (!isPlaying) return;

            currentTime += 0.04;
            if (currentTime > totalTimelineDuration) {
                if (isRecording) stopExport();
                currentTime = 0;
            }

            document.getElementById('timeDisplay').innerText = `${currentTime.toFixed(1)}s / ${totalTimelineDuration}s`;

            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = "#000";
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            let v1Active = checkAndPlayVideo(vid1, v1StartSec, 'v1Start', 'v1End');
            let v2Active = checkAndPlayVideo(vid2, v2StartSec, 'v2Start', 'v2End');
            checkAndPlayAudio(aud1, a1StartSec);

            if (v1Active && v2Active) {
                ctx.drawImage(vid1, 0, 0, canvas.width / 2, canvas.height);
                ctx.drawImage(vid2, canvas.width / 2, 0, canvas.width / 2, canvas.height);
            } else if (v1Active) {
                ctx.drawImage(vid1, 0, 0, canvas.width, canvas.height);
            } else if (v2Active) {
                ctx.drawImage(vid2, 0, 0, canvas.width, canvas.height);
            } else {
                ctx.fillStyle = "#00e5ff";
                ctx.font = "14px Arial";
                ctx.fillText("Slide Timeline Blocks & Play", 200, 180);
            }

            requestAnimationFrame(renderLoop);
        }

        function checkAndPlayVideo(videoElem, timelineStart, trimStartId, trimEndId) {
            if (!videoElem.src) return false;

            let trimStart = parseFloat(document.getElementById(trimStartId).value) || 0;
            let trimEnd = parseFloat(document.getElementById(trimEndId).value) || videoElem.duration;
            let videoDuration = trimEnd - trimStart;

            if (currentTime >= timelineStart && currentTime <= (timelineStart + videoDuration)) {
                let targetVideoTime = trimStart + (currentTime - timelineStart);
                if (Math.abs(videoElem.currentTime - targetVideoTime) > 0.3) {
                    videoElem.currentTime = targetVideoTime;
                }
                if (videoElem.paused) videoElem.play();
                return true;
            } else {
                if (!videoElem.paused) videoElem.pause();
                return false;
            }
        }

        function checkAndPlayAudio(audioElem, timelineStart) {
            if (!audioElem.src) return;
            if (currentTime >= timelineStart) {
                if (audioElem.paused) audioElem.play();
            } else {
                if (!audioElem.paused) audioElem.pause();
            }
        }

        // Real Video Download Logic using Canvas Stream
        function exportMix() {
            if (isRecording) {
                stopExport();
                return;
            }

            recordedChunks = [];
            const stream = canvas.captureStream(30); // 30 FPS Canvas Recording

            mediaRecorder = new MediaRecorder(stream, { mimeType: 'video/webm' });

            mediaRecorder.ondataavailable = (e) => {
                if (e.data.size > 0) recordedChunks.push(e.data);
            };

            mediaRecorder.onstop = () => {
                const blob = new Blob(recordedChunks, { type: 'video/webm' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.style.display = 'none';
                a.href = url;
                a.download = 'Rox_Mixed_Video.webm';
                document.body.appendChild(a);
                a.click();
                window.URL.revokeObjectURL(url);
                document.getElementById('exportBtn').innerText = "⚡ Merge & Download";
                alert("Aapki Video File Download Ho Gayi Hai!");
            };

            currentTime = 0;
            isPlaying = true;
            isRecording = true;
            document.getElementById('exportBtn').innerText = "🔴 Exporting... (Click To Save)";
            mediaRecorder.start();
            renderLoop();
        }

        function stopExport() {
            isRecording = false;
            isPlaying = false;
            if (mediaRecorder && mediaRecorder.state !== 'inactive') {
                mediaRecorder.stop();
            }
        }
    </script>
</body>
</html>
